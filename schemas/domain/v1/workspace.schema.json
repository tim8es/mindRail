{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mindrail:schema:domain:v1:workspace",
  "title": "Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "createdAt", "updatedAt", "name", "status"],
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/EntityId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "./common.schema.json#/$defs/UtcDateTime"
    },
    "updatedAt": {
      "$ref": "./common.schema.json#/$defs/UtcDateTime"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived"]
    }
  }
}
