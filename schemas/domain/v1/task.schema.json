{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mindrail:schema:domain:v1:task",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspaceId",
    "goalId",
    "revision",
    "createdAt",
    "updatedAt",
    "title",
    "objective",
    "acceptanceCriteria",
    "requiredCapabilities",
    "dependencyTaskIds",
    "status"
  ],
  "properties": {
    "id": { "$ref": "urn:mindrail:schema:domain:v1:common#/$defs/EntityId" },
    "workspaceId": { "$ref": "urn:mindrail:schema:domain:v1:common#/$defs/EntityId" },
    "goalId": { "$ref": "urn:mindrail:schema:domain:v1:common#/$defs/EntityId" },
    "revision": { "type": "integer", "minimum": 1 },
    "createdAt": { "$ref": "urn:mindrail:schema:domain:v1:common#/$defs/UtcDateTime" },
    "updatedAt": { "$ref": "urn:mindrail:schema:domain:v1:common#/$defs/UtcDateTime" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "requiredCapabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "urn:mindrail:schema:domain:v1:common#/$defs/NamespacedName" }
    },
    "dependencyTaskIds": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "urn:mindrail:schema:domain:v1:common#/$defs/EntityId" }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "ready", "running", "blocked", "succeeded", "failed", "cancelled"]
    },
    "statusReason": { "$ref": "urn:mindrail:schema:domain:v1:common#/$defs/Reason" }
  }
}
